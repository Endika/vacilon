# Data: only the corpus is versioned
data/*
!data/corpus/

# Models: only the exported final model is versioned
models/*
!models/final/

# Python
.venv/
__pycache__/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Web
web/node_modules/
web/dist/
web/coverage/

# Ear model: fetched by `npm run ear`, kept out of git and out of the default precache
web/public/ear/*.tar.gz

# Runtime files copied from node_modules by vite.config.ts
web/public/voice/ort/
web/public/ear/vosk.*

# Editors and OS
.DS_Store
*.swp
