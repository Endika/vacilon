{
  "name": "chispa-web",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "eslint src test --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type:check": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "dev:lan": "vite --host 0.0.0.0 --mode lan",
    "preview:lan": "npm run build && vite preview --host 0.0.0.0 --port 4443 --mode lan",
    "icons": "tsx scripts/icons.ts",
    "ear": "bash scripts/ear-assets.sh",
    "prepare": "cd .. && husky web/.husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@lichess-org/vosk-browser": "0.0.3",
    "onnxruntime-web": "1.31.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": "^14.0.6"
  }
}
